@model PAW.Models.DTO.PageResult<PAW.Models.DTO.SupplierDTO>
@{ ViewData["Title"] = "Supplier Page"; }
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Supplier</h2>
        <a asp-action="Create" asp-route-page="@Model.Page" class="btn btn-primary" data-crud data-title="Add Supplier"><i class="bi bi-plus-circle"></i> Add Supplier</a>
    </div>
    <div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark"><tr><th>SupplierId</th>
<th>SupplierName</th>
<th>ContactName</th>
<th>ContactTitle</th>
<th>Phone</th>
<th>Address</th>
<th>City</th>
<th>Country</th>
<th>LastModified</th>
<th>ModifiedBy</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
            @if (Model.Items.Any()) {
                foreach (var item in Model.Items) {
                <tr>
                    <td>@item.SupplierId</td>
<td><strong>@item.SupplierName</strong></td>
<td>@item.ContactName</td>
<td>@item.ContactTitle</td>
<td>@item.Phone</td>
<td>@item.Address</td>
<td>@item.City</td>
<td>@item.Country</td>
<td>@(item.LastModified?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@item.ModifiedBy</td>
                    <td class="text-center"><div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.SupplierId" asp-route-page="@Model.Page" class="btn btn-sm btn-warning" data-crud data-title="Edit Supplier">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.SupplierId" class="btn btn-sm btn-info" data-crud data-title="Details Supplier">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.SupplierId" asp-route-page="@Model.Page" class="btn btn-sm btn-danger" data-crud data-title="Delete Supplier">Delete</a>
                    </div></td>
                </tr>
                }
            } else { <tr><td colspan="11" class="text-center">No records found.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PAW.Web.Models.PagerModel(Model.Page, Model.TotalPages, Model.TotalCount)" />
    </div></div>
</div>
<partial name="_CrudModal" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/crud.js" asp-append-version="true"></script>
}
