@model PAW.Models.DTO.PageResult<PAW.Models.DTO.PawTaskDTO>
@{ ViewData["Title"] = "Tasks Page"; }
<div class="container mt-4">
    <p class="text-muted small">CRUD de tareas mediante PAW.MinimalAPI · SQL Server con ADO.NET e inyección de dependencias.</p>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tasks</h2>
        <a asp-action="Create" asp-route-page="@Model.Page" class="btn btn-primary" data-crud data-title="Add Task"><i class="bi bi-plus-circle"></i> Add Task</a>
    </div>
    <div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark"><tr><th>Id</th>
<th>Name</th>
<th>Description</th>
<th>Status</th>
<th>DueDate</th>
<th>CreatedAt</th>
<th>LastModified</th>
<th>ModifiedBy</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
            @if (Model.Items.Any()) {
                foreach (var item in Model.Items) {
                <tr>
                    <td>@item.Id</td>
<td><strong>@item.Name</strong></td>
<td>@item.Description</td>
<td>@item.Status</td>
<td>@(item.DueDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@(item.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@(item.LastModified?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@item.ModifiedBy</td>
                    <td class="text-center"><div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.Id" asp-route-page="@Model.Page" class="btn btn-sm btn-warning" data-crud data-title="Edit Task">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" data-crud data-title="Details Task">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" asp-route-page="@Model.Page" class="btn btn-sm btn-danger" data-crud data-title="Delete Task">Delete</a>
                    </div></td>
                </tr>
                }
            } else { <tr><td colspan="9" class="text-center">No records found.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PAW.Web.Models.PagerModel(Model.Page, Model.TotalPages, Model.TotalCount)" />
    </div></div>
</div>
<partial name="_CrudModal" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/crud.js" asp-append-version="true"></script>
}
