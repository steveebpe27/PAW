@model PAW.Models.DTO.PageResult<PAW.Models.DTO.InventoryDTO>
@{ ViewData["Title"] = "Inventory Page"; }
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Inventory</h2>
        <a asp-action="Create" asp-route-page="@Model.Page" class="btn btn-primary" data-crud data-title="Add Inventory"><i class="bi bi-plus-circle"></i> Add Inventory</a>
    </div>
    <div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark"><tr><th>InventoryId</th>
<th>UnitPrice</th>
<th>UnitsInStock</th>
<th>LastUpdated</th>
<th>ProductId</th>
<th>DateAdded</th>
<th>ModifiedBy</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
            @if (Model.Items.Any()) {
                foreach (var item in Model.Items) {
                <tr>
                    <td>@item.InventoryId</td>
<td>@item.UnitPrice</td>
<td>@item.UnitsInStock</td>
<td>@(item.LastUpdated?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@item.ProductId</td>
<td>@(item.DateAdded?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@item.ModifiedBy</td>
                    <td class="text-center"><div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.InventoryId" asp-route-page="@Model.Page" class="btn btn-sm btn-warning" data-crud data-title="Edit Inventory">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.InventoryId" class="btn btn-sm btn-info" data-crud data-title="Details Inventory">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.InventoryId" asp-route-page="@Model.Page" class="btn btn-sm btn-danger" data-crud data-title="Delete Inventory">Delete</a>
                    </div></td>
                </tr>
                }
            } else { <tr><td colspan="8" class="text-center">No records found.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PAW.Web.Models.PagerModel(Model.Page, Model.TotalPages, Model.TotalCount)" />
    </div></div>
</div>
<partial name="_CrudModal" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/crud.js" asp-append-version="true"></script>
}
