@model PAW.Models.DTO.InventoryDTO
@{ var mode = (string)ViewData["Mode"]!; }
<form asp-action="@mode" asp-route-id="@ViewData["RecordId"]" method="post" data-crud-form>
    @Html.AntiForgeryToken()
    <input type="hidden" name="page" value="@ViewData["Page"]" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="UnitPrice" class="form-label"></label><input asp-for="UnitPrice" type="number" step="0.01" class="form-control" /><span asp-validation-for="UnitPrice" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="UnitsInStock" class="form-label"></label><input asp-for="UnitsInStock" class="form-control" /><span asp-validation-for="UnitsInStock" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="LastUpdated" class="form-label"></label><input asp-for="LastUpdated" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="LastUpdated" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="ProductId" class="form-label"></label><select asp-for="ProductId" class="form-select">
                <option value="">Seleccionar…</option>
                @foreach (var option in ((IEnumerable<PAW.Models.DTO.LookupOption>)ViewData["ProductIdOptions"]!)) { <option value="@option.Id">@option.Id — @option.Name</option> }
            </select><span asp-validation-for="ProductId" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="DateAdded" class="form-label"></label><input asp-for="DateAdded" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="DateAdded" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="ModifiedBy" class="form-label"></label><input asp-for="ModifiedBy" class="form-control" /><span asp-validation-for="ModifiedBy" class="text-danger"></span></div></div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
</form>
