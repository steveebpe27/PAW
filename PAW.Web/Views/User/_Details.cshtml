@model PAW.Models.DTO.UserDTO
<dl class="row">
<dt class="col-sm-3">UserId</dt><dd class="col-sm-9">@Model.UserId</dd>
<dt class="col-sm-3">Username</dt><dd class="col-sm-9">@Model.Username</dd>
<dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">CreatedAt</dt><dd class="col-sm-9">@(Model.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
<dt class="col-sm-3">IsActive</dt><dd class="col-sm-9">@Model.IsActive</dd>
<dt class="col-sm-3">LastModified</dt><dd class="col-sm-9">@(Model.LastModified?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
<dt class="col-sm-3">ModifiedBy</dt><dd class="col-sm-9">@Model.ModifiedBy</dd>
<dt class="col-sm-3">RoleId</dt><dd class="col-sm-9">@Model.RoleId</dd>
<dt class="col-sm-3">LastModifiedBy</dt><dd class="col-sm-9">@Model.LastModifiedBy</dd>
</dl>
<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
