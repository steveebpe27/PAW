@model PAW.Models.DTO.PageResult<PAW.Models.DTO.UserDTO>
@{ ViewData["Title"] = "User Page"; }
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>User</h2>
        <a asp-action="Create" asp-route-page="@Model.Page" class="btn btn-primary" data-crud data-title="Add User"><i class="bi bi-plus-circle"></i> Add User</a>
    </div>
    <div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark"><tr><th>UserId</th>
<th>Username</th>
<th>Email</th>
<th>CreatedAt</th>
<th>IsActive</th>
<th>LastModified</th>
<th>ModifiedBy</th>
<th>RoleId</th>
<th>LastModifiedBy</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
            @if (Model.Items.Any()) {
                foreach (var item in Model.Items) {
                <tr>
                    <td>@item.UserId</td>
<td>@item.Username</td>
<td>@item.Email</td>
<td>@(item.CreatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@item.IsActive</td>
<td>@(item.LastModified?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@item.ModifiedBy</td>
<td>@item.RoleId</td>
<td>@item.LastModifiedBy</td>
                    <td class="text-center"><div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.UserId" asp-route-page="@Model.Page" class="btn btn-sm btn-warning" data-crud data-title="Edit User">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.UserId" class="btn btn-sm btn-info" data-crud data-title="Details User">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.UserId" asp-route-page="@Model.Page" class="btn btn-sm btn-danger" data-crud data-title="Delete User">Delete</a>
                    </div></td>
                </tr>
                }
            } else { <tr><td colspan="10" class="text-center">No records found.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PAW.Web.Models.PagerModel(Model.Page, Model.TotalPages, Model.TotalCount)" />
    </div></div>
</div>
<partial name="_CrudModal" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/crud.js" asp-append-version="true"></script>
}
