@model PAW.Models.DTO.PageResult<PAW.Models.DTO.RoleDTO>
@{ ViewData["Title"] = "Roles Page"; }
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Roles</h2>
        <a asp-action="Create" asp-route-page="@Model.Page" class="btn btn-primary" data-crud data-title="Add Role"><i class="bi bi-plus-circle"></i> Add Role</a>
    </div>
    <div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark"><tr><th>RoleId</th>
<th>RoleName</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
            @if (Model.Items.Any()) {
                foreach (var item in Model.Items) {
                <tr>
                    <td>@item.RoleId</td>
<td>@item.RoleName</td>
                    <td class="text-center"><div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.RoleId" asp-route-page="@Model.Page" class="btn btn-sm btn-warning" data-crud data-title="Edit Role">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.RoleId" class="btn btn-sm btn-info" data-crud data-title="Details Role">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.RoleId" asp-route-page="@Model.Page" class="btn btn-sm btn-danger" data-crud data-title="Delete Role">Delete</a>
                    </div></td>
                </tr>
                }
            } else { <tr><td colspan="3" class="text-center">No records found.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PAW.Web.Models.PagerModel(Model.Page, Model.TotalPages, Model.TotalCount)" />
    </div></div>
</div>
<partial name="_CrudModal" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/crud.js" asp-append-version="true"></script>
}
