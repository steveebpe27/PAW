@model PAW.Models.DTO.PageResult<PAW.Models.DTO.ProductDTO>
@{ ViewData["Title"] = "Product Page"; }


<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>
        <a asp-action="Create" asp-route-page="@Model.Page" class="btn btn-primary" data-crud data-title="Add Product"><i class="bi bi-plus-circle"></i> Add Product</a>
    </div>
    <div class="card shadow-sm"><div class="card-body"><div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark"><tr><th>ProductId</th>
<th>Name</th>
<th>Description</th>
<th>Rating</th>
<th>Comments</th>
<th>CreatedBy</th>
<th>CreatedDate</th>
<th>ModifiedBy</th>
<th>ModifiedDate</th><th class="text-center">Actions</th></tr></thead>
            <tbody>
            @if (Model.Items.Any()) {
                foreach (var item in Model.Items) {
                <tr>
                    <td>@item.ProductId</td>
<td><strong>@item.Name</strong></td>
<td>@item.Description</td>
<td>@for (var star = 1; star <= 5; star++) {
                    if (star <= (item.Rating ?? 0)) { <span class="text-warning">★</span> }
                    else { <span class="text-muted">☆</span> }
                }</td>
<td>@item.Comments</td>
<td>@item.CreatedBy</td>
<td>@(item.CreatedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
<td>@item.ModifiedBy</td>
<td>@(item.ModifiedDate?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                    <td class="text-center"><div class="btn-group" role="group">
                        <a asp-action="Edit" asp-route-id="@item.ProductId" asp-route-page="@Model.Page" class="btn btn-sm btn-warning" data-crud data-title="Edit Product">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-sm btn-info" data-crud data-title="Details Product">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.ProductId" asp-route-page="@Model.Page" class="btn btn-sm btn-danger" data-crud data-title="Delete Product">Delete</a>
                    </div></td>
                </tr>
                }
            } else { <tr><td colspan="10" class="text-center">No records found.</td></tr> }
            </tbody>
        </table>
    </div>
    <partial name="_Pagination" model="new PAW.Web.Models.PagerModel(Model.Page, Model.TotalPages, Model.TotalCount)" />
    </div></div>
</div>
<partial name="_CrudModal" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/crud.js" asp-append-version="true"></script>
}
