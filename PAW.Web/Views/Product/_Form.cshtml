@model PAW.Models.DTO.ProductDTO
@{ var mode = (string)ViewData["Mode"]!; }
<form asp-action="@mode" asp-route-id="@ViewData["RecordId"]" method="post" data-crud-form>
    @Html.AntiForgeryToken()
    <input type="hidden" name="page" value="@ViewData["Page"]" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row"><div class="col-md-6 mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="InventoryId" class="form-label"></label><select asp-for="InventoryId" class="form-select">
                <option value="">Seleccionar…</option>
                @foreach (var option in ((IEnumerable<PAW.Models.DTO.LookupOption>)ViewData["InventoryIdOptions"]!)) { <option value="@option.Id">@option.Id — @option.Name</option> }
            </select><span asp-validation-for="InventoryId" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="SupplierId" class="form-label"></label><select asp-for="SupplierId" class="form-select">
                <option value="">Seleccionar…</option>
                @foreach (var option in ((IEnumerable<PAW.Models.DTO.LookupOption>)ViewData["SupplierIdOptions"]!)) { <option value="@option.Id">@option.Id — @option.Name</option> }
            </select><span asp-validation-for="SupplierId" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Rating" class="form-label"></label><input asp-for="Rating" type="number" step="0.01" class="form-control" /><span asp-validation-for="Rating" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="CategoryId" class="form-label"></label><select asp-for="CategoryId" class="form-select">
                <option value="">Seleccionar…</option>
                @foreach (var option in ((IEnumerable<PAW.Models.DTO.LookupOption>)ViewData["CategoryIdOptions"]!)) { <option value="@option.Id">@option.Id — @option.Name</option> }
            </select><span asp-validation-for="CategoryId" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="LastModified" class="form-label"></label><input asp-for="LastModified" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" /><span asp-validation-for="LastModified" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="ModifiedBy" class="form-label"></label><input asp-for="ModifiedBy" class="form-control" /><span asp-validation-for="ModifiedBy" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="CreatedBy" class="form-label"></label><input asp-for="CreatedBy" class="form-control" /><span asp-validation-for="CreatedBy" class="text-danger"></span></div></div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
</form>
