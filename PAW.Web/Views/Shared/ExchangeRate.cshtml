@* El HTML no contiene valores: site.js carga y cachea el tipo de cambio. *@
<aside id="exchange-rate" class="exchange-widget" data-exchange-widget aria-label="Tipo de cambio de Hacienda" aria-busy="true">
    <header class="exchange-heading">
        <span class="exchange-symbol" aria-hidden="true">₡</span>
        <div class="exchange-heading-text">
            <h2>Tipo de cambio</h2>
            <span>Costa Rica · USD / EUR</span>
        </div>
        <button type="button" class="exchange-toggle" data-exchange-toggle aria-controls="exchange-body" aria-expanded="true" aria-label="Minimizar tipo de cambio">
            <span data-exchange-toggle-icon aria-hidden="true">−</span>
        </button>
    </header>
    <div id="exchange-body" class="exchange-body">
        <p class="exchange-status" data-exchange-status role="status" aria-live="polite">Consultando Hacienda…</p>
        <div data-exchange-values hidden>
            <section class="exchange-currency" aria-labelledby="exchange-usd">
                <div class="exchange-currency-title"><h3 id="exchange-usd">USD <span>Dólar estadounidense</span></h3><span class="exchange-unit">CRC / USD</span></div>
                <div class="exchange-quotes">
                    <div><span>Compra</span><strong data-rate="buy">—</strong></div>
                    <div><span>Venta</span><strong data-rate="sell">—</strong></div>
                </div>
                <p class="exchange-date">Compra: <span data-rate="buy-date">—</span> · Venta: <span data-rate="sell-date">—</span></p>
            </section>
            <section class="exchange-currency" aria-labelledby="exchange-eur">
                <div class="exchange-currency-title"><h3 id="exchange-eur">EUR <span>Euro</span></h3><span class="exchange-unit">POR EUR</span></div>
                <div class="exchange-quotes exchange-quotes-euro">
                    <div><span>Dólares</span><strong data-rate="euro-usd">—</strong></div>
                    <div><span>Colones</span><strong data-rate="euro-crc">—</strong></div>
                </div>
                <p class="exchange-date">Fecha de referencia: <span data-rate="euro-date">—</span></p>
            </section>
        </div>
        <p class="exchange-cache" data-exchange-cache>La consulta se guarda por 15 minutos en este navegador.</p>
        <button class="exchange-refresh" type="button" data-exchange-refresh>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5M6.1 7a7 7 0 0 1 11.5-1L20 9M4 15l2.4 3A7 7 0 0 0 17.9 17" /></svg>
            Actualizar
        </button>
        <a class="exchange-source" href="https://api.hacienda.go.cr/indicadores/tc" target="_blank" rel="noopener noreferrer">Fuente: Ministerio de Hacienda ↗</a>
        <noscript><p class="exchange-status">Activá JavaScript para consultar el tipo de cambio.</p></noscript>
    </div>
</aside>
